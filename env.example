# ============================================================================
# LLM CONFIGURATION
# ============================================================================
# The language model reads the PDF's bibliography and judges citation support.
# Gemini is NOT required. Choose one LLM_PROVIDER:
#   google             Gemini (free key: aistudio.google.com)
#   openai             OpenAI (paid key)
#   openai_compatible  Any OpenAI-style server: Groq, OpenRouter, Ollama, LM Studio, vLLM
LLM_PROVIDER="google"
GOOGLE_API_KEY="your-google-api-key"
GOOGLE_MODEL="gemini-3.6-flash"
# Only applies to the older Gemini 2.5 Flash models (discontinued 2026-10-16):
# their "thinking" slows structured extraction and invites 503s. 0 = off.
GOOGLE_THINKING_BUDGET=0

OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# Models tried in order when the main one is overloaded (503), rate limited or
# unavailable. "model" = same provider, "provider:model" = another provider.
# Left empty, Gemini falls back to gemini-3.1-flash-lite, then gemini-3.5-flash.
# "none" disables fallback. Example adding a free Groq model as a last resort:
# LLM_FALLBACK_MODELS="gemini-3.1-flash-lite,gemini-3.5-flash,openai_compatible:llama-3.3-70b-versatile"
LLM_FALLBACK_MODELS=

# OpenAI-compatible server (used when LLM_PROVIDER=openai_compatible, or as a
# fallback above). Largest output requested from it per call:
OPENAI_COMPATIBLE_MAX_TOKENS=8192
# Presets — uncomment one block:
#   Groq (key from console.groq.com). Fast, but the free tier allows roughly
#   8,000-12,000 tokens per minute and counts requested output, so keep the cap
#   low. Best as the last fallback rather than the main model for long papers:
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_MODEL=llama-3.3-70b-versatile
# OPENAI_COMPATIBLE_API_KEY=your-groq-key
# OPENAI_COMPATIBLE_MAX_TOKENS=6000
#   OpenRouter (many models, some free; key from openrouter.ai):
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_COMPATIBLE_API_KEY=your-openrouter-key
#   Ollama on this computer (fully offline, no key; see compose.offline.yml):
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_MODEL=llama3.1:8b-instruct-q4_K_M

MAX_TOKENS=32000

# ============================================================================
# HUGGINGFACE CONFIGURATION (Used for Scoring)
# ============================================================================
HF_API_TOKEN="your-hf-token"
HF_MODEL="meta-llama/Llama-3.1-8B-Instruct"
HF_BATCH_SIZE=20

# ============================================================================
# SCORING CONFIGURATION
# ============================================================================
EMBEDDING_WEIGHT=0.4
LLM_WEIGHT=0.6
RELEVANT_THRESHOLD=70
BORDERLINE_THRESHOLD=40

# ============================================================================
# EXTERNAL API CONFIGURATION
# ============================================================================
OPENALEX_EMAIL="your.email@example.com"
OPENALEX_RATE_LIMIT=0.2
ENABLE_PUBLISHER_SCRAPING="false"
API_RETRY_COUNT=3
API_RETRY_DELAY=2.0

# ============================================================================
# ELSEVIER CONFIGURATION (Used for Enrichment)
# ============================================================================
ELSEVIER_API_KEY = "your_key_here"

# ============================================================================
# SPRINGER CONFIGURATION (Used for Enrichment)
# ============================================================================
SPRINGER_API_KEY = "your_key_here"

# ============================================================================
# LOGGING & PROCESSING
# ============================================================================
LOG_LEVEL="INFO"
ENABLE_CACHE="true"
MAX_PDF_BYTES=52428800

# Optional Phase 1 evidence ledger. Restart Streamlit after configuration changes.
TRUST_KERNEL_ENABLED=false
TRUST_DATABASE_URL=postgresql://citeprism_app:citeprism-app-dev-only@127.0.0.1:55432/citeprism_trust_dev
TRUST_DATABASE_RUNTIME_ROLE=citeprism_app
TRUST_TENANT_ID=00000000-0000-4000-8000-000000000001
TRUST_ACTOR_ID=citeprism-streamlit
TRUST_OBJECT_STORE_BACKEND=local
TRUST_OBJECT_STORE_DIR=data/trust_objects
# Administrator credentials belong ONLY in a separate migration job/process.
# TRUST_MIGRATION_DATABASE_URL is optional there; do not add it to runtime .env.
# CITEPRISM_BASE_DIR may point at a writable runtime directory for installed wheels.

# S3 is optional; credentials use the normal AWS SDK provider chain.
# TRUST_S3_BUCKET=your-bucket
TRUST_S3_PREFIX=citeprism
TRUST_S3_REGION=us-east-1
TRUST_S3_REQUIRE_VERSIONING=true
TRUST_S3_SERVER_SIDE_ENCRYPTION=AES256
# TRUST_S3_KMS_KEY_ID=your-key-arn
# TRUST_S3_ENDPOINT_URL is only for compatible development object stores.

# Phase 2: source resolution credentials and optional topic diagnostic.
OPENALEX_API_KEY=
ENABLE_TOPIC_SIMILARITY=true

# Phase 3 reviewer workspace. `local` is for one-machine development only.
CITEPRISM_AUTH_MODE=local
CITEPRISM_DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
CITEPRISM_JOB_WORKERS=2
CITEPRISM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Production must use an identity-aware reverse proxy that strips and replaces
# the CitePrism identity headers. Set trusted_proxy and a high-entropy shared secret.
# CITEPRISM_AUTH_MODE=trusted_proxy
# CITEPRISM_PROXY_SECRET=replace-with-a-secret-manager-value

# ============================================================================
# PHASE 4 — ENTERPRISE RUNTIME
# ============================================================================
# Workspace persistence. `sqlite` is the single-workstation profile and stays
# the default. `postgres` activates the durable multi-process runtime.
CITEPRISM_WORKSPACE_BACKEND=sqlite
# CITEPRISM_WORKSPACE_DATABASE_URL=postgresql://citeprism_workspace_app:citeprism-workspace-dev-only@127.0.0.1:55433/citeprism_workspace
# Administrator DSN, used only by scripts/migrate_workspace.py. Never in runtime .env.
# CITEPRISM_WORKSPACE_MIGRATION_DATABASE_URL=postgresql://citeprism_admin:...@127.0.0.1:55433/citeprism_workspace
CITEPRISM_WORKSPACE_SCHEMA=citeprism_workspace

# Durable queue. A worker renews its lease every heartbeat; a crashed worker's
# job returns to the queue once the lease expires.
CITEPRISM_QUEUE_LEASE_SECONDS=120
CITEPRISM_QUEUE_HEARTBEAT_SECONDS=20
CITEPRISM_QUEUE_MAX_ATTEMPTS=3
CITEPRISM_QUEUE_BACKOFF_SECONDS=15
# Set false and run scripts/worker.py to separate execution from the API.
CITEPRISM_RUN_EMBEDDED_WORKER=true

# Object storage. `local` is content-addressed on disk; `s3` is any
# S3-compatible endpoint (AWS S3, MinIO, Ceph RGW).
CITEPRISM_OBJECT_BACKEND=local
CITEPRISM_OBJECT_DIR=data/workspace_objects
# CITEPRISM_S3_BUCKET=citeprism
# CITEPRISM_S3_ENDPOINT_URL=http://127.0.0.1:9000
# CITEPRISM_S3_REGION=us-east-1
# CITEPRISM_S3_ADDRESSING=path
# CITEPRISM_S3_REQUIRE_VERSIONING=true
# Credentials use the standard AWS SDK provider chain; do not put them here.

# OIDC. Set CITEPRISM_AUTH_MODE=oidc to have the API verify bearer tokens
# itself against the issuer's published keys.
# CITEPRISM_OIDC_ISSUER=https://login.example.org/realms/citeprism
# CITEPRISM_OIDC_AUDIENCE=citeprism-api
# CITEPRISM_OIDC_JWKS_URL is discovered from the issuer when omitted.
CITEPRISM_OIDC_ALGORITHMS=RS256,ES256
CITEPRISM_OIDC_TENANT_CLAIM=org_id
CITEPRISM_OIDC_ROLES_CLAIM=roles
# Map directory groups onto CitePrism roles:
# CITEPRISM_OIDC_ROLE_MAP=Editorial-Leads=lead_reviewer,Editorial-Staff=reviewer

# Evidence acquisition. OCR needs the tesseract binary as well as pytesseract.
CITEPRISM_ENABLE_OCR=false
CITEPRISM_OCR_LANGUAGES=eng
CITEPRISM_OCR_DPI=300
CITEPRISM_OCR_MAX_PAGES=60
# Full text is fetched only from open-access locations, never from behind a licence.
CITEPRISM_ENABLE_FULL_TEXT=false
CITEPRISM_ENABLE_UNPAYWALL=false
# UNPAYWALL_EMAIL=your.email@example.com

# Identity resolution across scholarly indexes.
CITEPRISM_RESOLUTION_PROVIDERS=openalex,crossref,semantic_scholar
# Asked only when the indexes above cannot resolve a reference: dblp (computer
# science), europe_pmc (life sciences), datacite (datasets, software, arXiv and
# Zenodo DOIs). Leave empty to disable.
CITEPRISM_SUPPLEMENTARY_PROVIDERS=dblp,europe_pmc,datacite
# If dblp.org fails (or a local filter blocks it), its official mirror is tried next.
# CITEPRISM_DBLP_MIRROR_URLS=https://dblp.uni-trier.de
# Without a key Semantic Scholar often answers "too many requests"; affected
# references are then shown as "not checked". Add a free key, or drop
# semantic_scholar from the list above.
# SEMANTIC_SCHOLAR_API_KEY=
# CROSSREF_MAILTO=your.email@example.com

# Signed review packages. Generate a key with:
#   .\scripts\setup_phase4.ps1 -GenerateSigningKey
CITEPRISM_EXPORT_SIGNING=ed25519
# CITEPRISM_EXPORT_SIGNING_KEY=secrets/export-signing.key
CITEPRISM_EXPORT_SIGNING_KEY_ID=citeprism-export-1
CITEPRISM_EXPORT_RETENTION_DAYS=365

# Telemetry and service objectives.
CITEPRISM_ENABLE_TELEMETRY=true
CITEPRISM_SLO_WINDOW_HOURS=168
CITEPRISM_SLO_AUDIT_P95_SECONDS=900
CITEPRISM_SLO_QUEUE_WAIT_P95_SECONDS=60
CITEPRISM_SLO_AUDIT_SUCCESS_RATIO=0.98
CITEPRISM_SLO_RESOLUTION_RATIO=0.85
CITEPRISM_SLO_SYSTEM_ISSUE_RATIO=0.05
CITEPRISM_SLO_COST_PER_AUDIT_USD=1.50
# CITEPRISM_PRICING_TABLE=config/pricing.json

# Evaluation datasets.
CITEPRISM_EVAL_DATASET_DIR=data/evaluation
CITEPRISM_EVAL_CALIBRATION_BINS=10

# ============================================================================
# CitePrism V2.0 analysis layer (5.1)
# ============================================================================
# Hybrid relevance: RS_final = LLM_WEIGHT * RS_llm + EMBEDDING_WEIGHT * RS_embed.
# RELEVANT_THRESHOLD / BORDERLINE_THRESHOLD above label the result. They are
# defaults; calibrate them with scripts/run_evaluation.py on labelled data.
# Topic similarity backend: auto | sentence_transformers | hf_inference | lexical | off
CITEPRISM_SIMILARITY_BACKEND=auto
# Claim assessment provider: huggingface | google | openai | openai_compatible
CITEPRISM_ASSESSMENT_PROVIDER=huggingface

# Self-citation pattern review thresholds.
CITEPRISM_SELF_CITATION_RATE=0.25
CITEPRISM_SELF_CITATION_MIN_COUNT=3
CITEPRISM_SELF_CITATION_CONCENTRATION=0.15

# Literature-gap analysis (co-citation graph + verification of model leads).
CITEPRISM_ENABLE_GAP_ANALYSIS=true
# CITEPRISM_GAP_MIN_SUPPORT=        # default: max(2, 8% of references with graph data)
CITEPRISM_GAP_MAX_CANDIDATES=15

# Efficiency: parallel, rate-limited metadata lookups (1-16).
CITEPRISM_ENRICHMENT_CONCURRENCY=4
# Per-provider request rates (requests/second) can be overridden, e.g.
# CITEPRISM_RATE_OPENALEX=8
# CITEPRISM_RATE_SEMANTIC_SCHOLAR=0.9

# Plain-language assistant in the web app. "auto": built-in answers, plus the
# configured model for other questions (answers use this audit's results only).
# "off": built-in answers only, no model calls.
CITEPRISM_ASSISTANT_MODEL=auto

# What you have arranged with the model services that receive manuscript text.
# Free plans may keep it: Google's Gemini API terms for unpaid use say content is
# used to improve its products, may be read by human reviewers, and that
# confidential information must not be submitted. A paper under peer review is
# confidential.
#   unverified   (default) the upload screen names the services and warns people
#                not to upload confidential papers
#   no_training  you use paid plans whose terms exclude training (e.g. a
#                data-processing agreement); shown as such
#   local_only   enforced: CitePrism refuses to start unless every model that
#                receives manuscript text runs on a local or private-network host
CITEPRISM_MODEL_DATA_TERMS=unverified

# Offline / data-sovereign deployment. See compose.offline.yml.
CITEPRISM_OFFLINE_MODE=false
# Offline also needs LLM_PROVIDER=openai_compatible with the Ollama preset above.
